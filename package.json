{
  "name": "hidenseek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prop-hunt style hide and seek for phones and browsers. Join friends with a room code.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "props": "node scripts/build-prop-catalog.mjs",
    "test": "tsx --test tests/map.test.ts tests/room.test.ts",
    "e2e": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "4.21.2",
    "three": "0.160.0",
    "tsx": "4.19.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/three": "0.160.0",
    "@types/ws": "8.5.13",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
